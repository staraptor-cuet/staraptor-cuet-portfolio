# ==============================================================
# STARAPTOR CUET - ENVIRONMENT VARIABLES CONFIGURATION
# ==============================================================

# --- Admin Authentication ---
# Credentials for accessing /admin dashboard
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your_secure_password_here
ADMIN_SECRET=generate_a_random_32_character_secret_string

# --- Cloudinary Cloud Storage (Recommended: 25 GB Free Global CDN) ---
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# --- Cloudflare R2 Storage (Optional Alternative: 10 GB Free) ---
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_NAME=staraptor-media
# R2_PUBLIC_URL=https://pub-xxxxxx.r2.dev

# --- Supabase Auth & Email Password Reset (Free at https://supabase.com) ---
# When configured, enables "Forgot Password?" email reset links
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-public-key
# SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# --- Groq AI API ---
GROQ_API_KEYS=your_groq_api_key_here
GROQ_API_KEY=your_groq_api_key_here




# ==============================================================
# --- Website assistant (Raptor) ---
# Copy to .env.local for local development. Set the same names in Vercel > Project > Settings > Environment Variables.
# Never commit real values and never prefix these with NEXT_PUBLIC_ (that would expose them to browsers).

# Groq API key(s), comma-separated. The first key is the primary; later keys are only tried after an error.
GROQ_API_KEYS=

# Upstash Redis (free tier): rate limits, answer cache, chat logs, feedback. Optional for local development.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Kill switch: ai (default) | faq (no LLM calls, FAQ answers only) | off (assistant hidden)
CHAT_MODE=ai

# Any long random string; used to hash visitor IPs before logging.
LOG_SALT=

# Extra origins allowed to call /api/chat, comma-separated (the production site and Vercel previews are allowed already).
CHAT_ALLOWED_ORIGINS=
